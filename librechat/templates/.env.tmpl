# pc-fee LibreChat Installer — .env
# WICHTIG: Sensible Daten. Nie in Git committen.

# === App-Konfiguration ===
HOST=https://${DOMAIN}
ALLOW_REGISTRATION=false

# === Admin ===
ADMIN_EMAIL=${ADMIN_EMAIL}
ADMIN_USERNAME=${ADMIN_NAME}

# === Secrets (auto-generiert vom Installer) ===
JWT_SECRET=${JWT_SECRET}
CREDS_KEY=${CREDS_KEY}
CREDS_IV=${CREDS_IV}

# === MongoDB ===
MONGO_URI=mongodb://mongodb:27017/librechat
