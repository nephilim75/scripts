services:
  api:
    image: registry.librechat.ai/danny-avila/librechat:dev-latest
    restart: unless-stopped
    ports: !reset []
    expose:
      - "3080"
    networks:
      - ${NETWORK_NAME}
      - librechat_internal
    env_file:
      - ${INSTALL_DIR}/.env
    depends_on:
      - mongodb
    volumes:
      - type: bind
        source: ${INSTALL_DIR}/librechat.yaml
        target: /app/librechat.yaml

  admin-panel:
    image: registry.librechat.ai/clickhouse/librechat-admin-panel:latest
    restart: unless-stopped
    ports: !reset []
    expose:
      - "3000"
    networks:
      - ${NETWORK_NAME}
      - librechat_internal
    environment:
      - VITE_API_BASE_URL=https://${DOMAIN}
      - API_SERVER_URL=http://api:3080
    depends_on:
      - api

  mongodb:
    image: mongo:8.0.20
    restart: unless-stopped
    ports: !reset []
    expose:
      - "27017"
    volumes:
      - ${INSTALL_DIR}/data/mongo:/data/db
    networks:
      - librechat_internal

  meilisearch:
    image: getmeili/meilisearch:v1.35.1
    restart: unless-stopped
    ports: !reset []
    expose:
      - "7700"
    volumes:
      - ${INSTALL_DIR}/data/meili:/meili_data
    environment:
      - MEILI_NO_ANALYTICS=true
      - MEILI_MASTER_KEY=${MEILI_API_KEY}
    networks:
      - librechat_internal

  pc-fee-toolkit:
    build: ./pc-fee-toolkit
    restart: unless-stopped
    ports: !reset []
    expose:
      - "3000"
    networks:
      - librechat_internal
    environment:
      - MONGO_URI=mongodb://mongodb:27017/librechat
      - LIBRECHAT_BASE_URL=http://api:3080
      - MEILI_HOST=http://meilisearch:7700
      - MEILI_API_KEY=${MEILI_API_KEY}

networks:
  ${NETWORK_NAME}:
    external: true
  librechat_internal:
    driver: bridge
