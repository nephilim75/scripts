# pc-fee LibreChat Installer — librechat.yaml
# Provider werden über das PC-FEE Toolkit im Admin-Panel hinzugefügt.
# Manuelle Bearbeitung möglich, Format siehe https://www.librechat.ai/docs

version: 1.0.0
cache: true

interface:
  customWelcome: "Willkommen bei deinem Chat"
