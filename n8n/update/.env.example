# =============================================================================
# n8n Update Script – Configuration
# =============================================================================
# Copy this file: cp .env.example .env
# Adjust the values to match your environment.
# IMPORTANT: Never commit .env to Git!
# =============================================================================

# Path to the directory containing docker-compose.yml
COMPOSE_DIR="/opt/n8n"

# Backup target directory
BACKUP_DIR="/opt/n8n/backups"

# n8n data directory (this will be backed up)
DATA_DIR="/opt/n8n/n8n_data"

# Maximum number of backups to keep
MAX_BACKUPS=5

# Docker Hub images (only change if you use a fork)
N8N_IMAGE="n8nio/n8n"
RUNNERS_IMAGE="n8nio/runners"

# URL of your n8n instance (used for health check after update)
HEALTH_CHECK_URL="https://your-n8n-domain.com"

# Health check: number of attempts and wait time in seconds
HEALTH_CHECK_RETRIES=12
HEALTH_CHECK_INTERVAL=5
